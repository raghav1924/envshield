{
  "variables": {
    "PORT": {
      "type": "port",
      "required": true,
      "default": "3000",
      "description": "Port number for the HTTP server to listen on."
    },
    "NODE_ENV": {
      "type": "enum",
      "required": true,
      "enum": ["development", "staging", "production", "test"],
      "description": "Application execution environment."
    },
    "APP_URL": {
      "type": "url",
      "required": true,
      "description": "Base canonical URL for webhooks and redirects."
    },
    "DATABASE_URL": {
      "type": "url",
      "required": true,
      "description": "PostgreSQL connection string."
    },
    "REDIS_URL": {
      "type": "url",
      "required": false,
      "description": "Redis cache connection string."
    },
    "STRIPE_SECRET_KEY": {
      "type": "secret",
      "required": true,
      "description": "Live Stripe API secret key."
    },
    "GITHUB_TOKEN": {
      "type": "string",
      "required": false,
      "description": "GitHub personal access token."
    },
    "ENABLE_ANALYTICS": {
      "type": "boolean",
      "required": false,
      "default": "false",
      "description": "Toggle telemetric event collection."
    }
  }
}

